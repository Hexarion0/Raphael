# Environment & Logging
RAPHAEL_ENV=development
RAPHAEL_LOG_LEVEL=INFO
# Optional conversational name; separate from the desktop login.
RAPHAEL_PREFERRED_NAME=
# Optional UTF-8 style preferences, reloaded before each AI reply. Empty disables.
RAPHAEL_PERSONA_FILE=persona.txt

# AI Providers
NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_COMPLEX_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Audio & Voice Settings
WAKE_WORD=hey raphael
# Quiet-voice sensitivity (raise to reduce noise checks); retains slower greetings.
WAKE_MIN_RMS=0.006
WAKE_WINDOW_SECONDS=3.0
# Optional continuous transcription; background excerpts are temporary, not saved.
AMBIENT_LISTENING=true
AMBIENT_FOLLOWUP_SECONDS=40
# conversation keeps recent dialogue engaged; strict requires high gate confidence.
AMBIENT_FOLLOWUP_POLICY=conversation
# Includes rejected background transcripts in local logs; set false for normal use.
SHOW_TRANSCRIPTS=true
# Reveal AI caption letters during voice playback; separate from raw STT logs.
SHOW_AI_TRANSCRIPTS=true
# Headphones: speech interrupts playback without waiting for a wake word.
# Speakers: use wake to reduce interruptions caused by hearing RAPHAEL herself.
BARGE_IN_MODE=speech
BARGE_IN_SPEECH_SECONDS=0.24
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
STT_MODEL=small.en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
# Chatterbox Turbo is local/offline after setup; Piper remains the local fallback.
# Voice profile and reference assets are documented in docs/chatterbox-turbo-integration.md.
TTS_ENGINE=chatterbox_turbo
TTS_VOICE=raphael
TTS_FALLBACK_VOICE=en_US-raphael-medium
TTS_VOICE_PROFILES=voice_profiles
TTS_CHATTERBOX_MODEL=data/voice/models/chatterbox-turbo
TTS_CHATTERBOX_PYTHON=data/voice/envs/clone/bin/python
TTS_MIN_FREE_VRAM_MB=3000
TTS_AUDIO_QUEUE_SIZE=2
TTS_SPEED=1.0
TTS_ENABLED=true
# Speak completed sentences as the AI generates them; false restores batch replies.
TTS_STREAMING=true
FISH_SPEECH_URL=http://127.0.0.1:8080/v1/tts
FISH_REF_AUDIO=data/voices/mommy/ref.wav
FISH_REF_TEXT="Oh my god, did I like break your ribs or something? It's not my fault that you're fragile."

# Listening latency: raise these if you prefer more decoding or longer pauses
STT_BEAM_SIZE=3
UTTERANCE_SILENCE_SECONDS=1.0
# Additional thinking-pause tolerance before ending a turn (total default 1.8s).
UTTERANCE_PAUSE_GRACE_SECONDS=0.8

# Retry unclear utterances with a stronger decoder (loaded only when needed).
# Leave empty to retry the primary model; medium.en uses more RAM and CPU time.
STT_RETRY_MODEL=medium.en
# Free VRAM required before loading an additional CUDA retry model.
# Below this threshold, retry with the already loaded primary model instead.
STT_RETRY_MIN_FREE_MB=2048
# Diagnostic decoding scores, not calibrated accuracy probabilities.
STT_MIN_CONFIDENCE=0.4
STT_RETRY_CONFIDENCE=0.55
# Whisper wake recognition is independent of command transcription.
WAKE_STT_MODEL=base.en
